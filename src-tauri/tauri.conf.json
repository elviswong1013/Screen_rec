{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Screen_rec",
  "version": "0.1.0",
  "identifier": "com.screenrec.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Screen_rec",
        "width": 1024,
        "height": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../tools/ffmpeg/ffmpeg-n8.1-latest-win64-lgpl-8.1/bin/ffmpeg.exe": "ffmpeg/ffmpeg.exe",
      "../tools/ffmpeg/ffmpeg-n8.1-latest-win64-lgpl-8.1/bin/ffprobe.exe": "ffmpeg/ffprobe.exe",
      "resources/licenses/FFmpeg-LICENSE.txt": "licenses/FFmpeg-LICENSE.txt",
      "resources/licenses/GPLv3.txt": "licenses/GPLv3.txt",
      "resources/licenses/ffmpeg-source-offer.txt": "licenses/ffmpeg-source-offer.txt",
      "resources/licenses/ffmpeg-build-info.txt": "licenses/ffmpeg-build-info.txt",
      "resources/licenses/ffmpeg-build-script.sh": "licenses/ffmpeg-build-script.sh"
    }
  }
}
